<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LineInTray.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="音频输出快捷切换">
    <Grid x:Name="Root">
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center">
            <StackPanel Padding="28,24,28,28" Spacing="16" MaxWidth="900" HorizontalAlignment="Center">
                <Grid ColumnSpacing="14" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="52" Height="52" Source="ms-appx:///Assets/LineInTray.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="音频输出快捷切换" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="音频输出快捷切换，线路输入监听可选" Style="{StaticResource PanelSubtitleTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="打开快捷面板" Click="OnOpenPanelClick" />
                        <Button Content="退出" Click="OnExitClick" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="快速切换音频输出" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PanelIconButtonStyle}" Click="OnRefreshClick" ToolTipService.ToolTip="刷新设备">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button Content="+ 添加快捷方式" Style="{StaticResource AccentButtonStyle}" Click="OnAddPresetClick" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="PresetList" Spacing="8" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="监听控制" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <CheckBox x:Name="MonitoringEnabledCheck" Content="启用线路输入监听" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnMonitoringEnabledClick" />
                        </Grid>
                        <TextBlock x:Name="MonitoringOffText" Text="监听功能已关闭。快速切换和 Win+A 面板仍然可用。" Style="{StaticResource PanelSubtitleTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel x:Name="MonitorControls" Spacing="12">
                            <TextBlock x:Name="DefaultCaptureText" Style="{StaticResource PanelSubtitleTextStyle}" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MonitorButton" Height="38" MinWidth="150" Style="{StaticResource AccentButtonStyle}" Click="OnMonitorClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="MonitorIcon" Glyph="&#xE768;" FontSize="15" />
                                        <TextBlock x:Name="MonitorText" Text="开始监听" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="StatusText" Text="未监听" Style="{StaticResource PanelSubtitleTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="延迟" Style="{StaticResource PanelSubtitleTextStyle}" />
                                    <NumberBox x:Name="LatencyBox" Width="92" Minimum="0" Maximum="500" SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="OnLatencyChanged" />
                                    <TextBlock Text="ms" Style="{StaticResource PanelSubtitleTextStyle}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="录音设备" VerticalAlignment="Center" Style="{StaticResource PanelSubtitleTextStyle}" />
                                <ComboBox x:Name="CaptureCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnCaptureChanged" />
                                <Button x:Name="DeviceButton" Grid.Column="2" Content="启用/禁用" Click="OnToggleDeviceClick" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="播放到" VerticalAlignment="Center" Style="{StaticResource PanelSubtitleTextStyle}" />
                                <ComboBox x:Name="PlaybackCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnPlaybackChanged" />
                                <Button Grid.Column="2" Content="刷新设备" Click="OnRefreshClick" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <CheckBox x:Name="AutoMonitorCheck" Content="启动时自动监听" Click="OnAutoMonitorClick" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快捷键" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="切换音频输出" VerticalAlignment="Center" Style="{StaticResource PanelSubtitleTextStyle}" />
                            <TextBox x:Name="OutputHotkeyBox" Grid.Column="1" IsReadOnly="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" PlaceholderText="Ctrl+Alt+Shift+O" KeyDown="OnHotkeyBoxKeyDown" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="开关音频监听" VerticalAlignment="Center" Style="{StaticResource PanelSubtitleTextStyle}" />
                            <TextBox x:Name="MonitorHotkeyBox" Grid.Column="1" IsReadOnly="True" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" PlaceholderText="Ctrl+Alt+Shift+M" KeyDown="OnHotkeyBoxKeyDown" />
                        </Grid>
                        <TextBlock Text="点击输入框后按下组合键；Backspace/Delete 清除。" Style="{StaticResource PanelSubtitleTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="外观" Style="{StaticResource SectionHeaderTextStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="应用主题" VerticalAlignment="Center" Style="{StaticResource PanelSubtitleTextStyle}" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="OnThemeChanged" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷面板主题" VerticalAlignment="Center" Style="{StaticResource PanelSubtitleTextStyle}" />
                            <ComboBox x:Name="QuickThemeCombo" Grid.Column="1" SelectionChanged="OnQuickThemeChanged" />
                        </Grid>                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="界面语言" VerticalAlignment="Center" Style="{StaticResource PanelSubtitleTextStyle}" />
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectionChanged="OnLanguageChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="其他" Style="{StaticResource SectionHeaderTextStyle}" />
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Click="OnAutoStartClick" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开 Windows 声音设置" Click="OnOpenSoundClick" />
                            <Button Content="打开数据目录" Click="OnOpenDataClick" />
                            <Button Content="查看日志" Click="OnOpenLogClick" />
                            <Button Content="显示托盘图标" Click="OnReassertTrayClick" />
                        </StackPanel>
                        <TextBlock Text="提示：Windows 没有公开 API 可以把自定义控件插入音量弹窗；Win+A 面板始终显示快速切换，启用监听后才会多出监听控制。"
                                   Style="{StaticResource PanelSubtitleTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>















