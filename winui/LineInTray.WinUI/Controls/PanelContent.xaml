<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LineInTray.WinUI.Controls.PanelContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="16,14,16,12" Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE7F5;" FontSize="24" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="音频输入" Style="{StaticResource PanelTitleTextStyle}" />
                <TextBlock x:Name="StatusText" Text="线路输入 · 未监听" Style="{StaticResource PanelSubtitleTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                <Button x:Name="SettingsButton" Style="{StaticResource PanelIconButtonStyle}" Click="OnSettingsClick" ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource PanelIconButtonStyle}" Click="OnCloseClick" ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <Button x:Name="MonitorButton" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Style="{StaticResource AccentButtonStyle}" Click="OnMonitorClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="MonitorIcon" Glyph="&#xE768;" FontSize="16" />
                <TextBlock x:Name="MonitorText" Text="开始监听" />
            </StackPanel>
        </Button>

        <Grid>
            <TextBlock Text="快速切换" Style="{StaticResource SectionHeaderTextStyle}" VerticalAlignment="Center" />
            <Button Content="管理" HorizontalAlignment="Right" Padding="10,4" MinHeight="0"
                    Background="Transparent" BorderThickness="0" Click="OnManageClick" />
        </Grid>

        <StackPanel x:Name="PresetList" Spacing="8" />

        <Grid Margin="0,2,0,0">
            <Button x:Name="OpenMainButton" Content="打开主界面" HorizontalAlignment="Left" Padding="12,6" MinHeight="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Click="OnOpenMainClick" />
            <Button x:Name="ExitButton" Content="退出" HorizontalAlignment="Right" Padding="12,6" MinHeight="0"
                    Background="Transparent" BorderThickness="0" Click="OnExitClick" />
        </Grid>
    </StackPanel>
</UserControl>

